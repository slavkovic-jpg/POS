# Copy to .env and fill in. Never commit real keys.
# .env is gitignored.

# Enables the Claude-backed conversation. If unset, the server falls back to
# the built-in stub responder (no LLM calls).
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-4-8.
# Other valid options: claude-fable-5, claude-sonnet-5, claude-haiku-4-5-20251001
# POS_MODEL=claude-opus-4-8

# Optional server port. Defaults to 5185.
# PORT=5185
