# Copy to .env and fill in. Never commit real keys.
# .env is gitignored.

# Backends are tried in order: Claude -> Gemini -> Ollama -> scripted stub.
# Preferred backend: Claude API.
ANTHROPIC_API_KEY=

# Optional Claude model override. Defaults to claude-opus-4-8.
# Other valid options: claude-fable-5, claude-sonnet-5, claude-haiku-4-5-20251001
# POS_MODEL=claude-opus-4-8

# --- Google Gemini (second choice; fast and cheap) -------------------------
# Get a key at https://aistudio.google.com/apikey
# Worth setting even if you have a Claude key: voice mode needs a fast backend,
# and either of these qualifies. A local model does not.
GEMINI_API_KEY=

# Override if Google rotates the model name (a wrong id 404s with the id echoed
# back). Default matches the Canvas prototype this was ported from.
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_ENABLED=true

# --- Free hosted providers (recommended: fast, and several cost nothing) ----
# This machine has no CUDA GPU, so Ollama runs on the CPU at roughly 1-4 tokens
# per second. Any hosted provider is ~100x faster and several are free.
#
# One adapter covers all of these — set three variables and restart:
#
#   Groq          https://console.groq.com
#     OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
#
#   Cerebras      https://cloud.cerebras.ai      (fastest inference available)
#     OPENAI_COMPAT_BASE_URL=https://api.cerebras.ai/v1
#     OPENAI_COMPAT_MODEL=llama-3.3-70b
#
#   OpenRouter    https://openrouter.ai/keys     (models ending :free cost nothing)
#     OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
#     OPENAI_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   GitHub Models https://github.com/settings/tokens   (free with any GH account)
#     OPENAI_COMPAT_BASE_URL=https://models.github.ai/inference
#     OPENAI_COMPAT_MODEL=openai/gpt-4o-mini
#
# Settings -> Test connections verifies whichever you pick.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_LABEL=Groq
# OPENAI_COMPAT_ENABLED=true

# --- Ollama fallback -------------------------------------------------------
# Used automatically when ANTHROPIC_API_KEY is missing or the Claude call fails.
# Requires Ollama running locally and a model pulled. Default is qwen2.5:3b,
# which was chosen by measurement on this hardware: an 8B model here runs at
# about 1 token/sec (a trivial request took 179 seconds), while 3B manages the
# same extraction in ~45s. If it is still too slow, qwen2.5:1.5b is ~2x faster
# again and adequate for capture; if you get a machine with a real GPU, larger
# models become sensible.
#   ollama pull qwen2.5:3b
#   ollama pull qwen2.5:1.5b     (faster, less capable)
# The Ollama app on Windows/macOS starts the daemon automatically; otherwise:
#   ollama serve
# Set OLLAMA_ENABLED=false to skip Ollama and jump straight to the stub.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_ENABLED=true
# How long to wait on a local model, in ms. Prompt processing dominates on CPU
# and the system prompt grows as your strategy, tasks and knowledge fill in.
# OLLAMA_TIMEOUT_MS=300000
# Ollama's own default context is far smaller than most models support, and it
# silently drops the OLDEST tokens on overflow — i.e. the system prompt. Raising
# this costs RAM, not speed.
# OLLAMA_NUM_CTX=8192

# Optional server port. Defaults to 5185.
# PORT=5185
